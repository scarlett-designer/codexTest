{
  "color": {
    "bg": {
      "primary": "#2563EB",
      "surface": "#FFFFFF"
    },
    "text": {
      "default": "#0F172A",
      "inverse": "#FFFFFF"
    },
    "border": {
      "default": "#CBD5E1"
    }
  },
  "space": {
    "2": "0.5rem",
    "4": "1rem",
    "6": "1.5rem"
  },
  "radius": {
    "sm": "0.25rem",
    "md": "0.5rem"
  },
  "typography": {
    "fontFamily": "Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
    "fontSize": {
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem"
    },
    "fontWeight": {
      "regular": 400,
      "semibold": 600
    }
  },
  "component": {
    "button": {
      "primary": {
        "bg": "{color.bg.primary}",
        "text": "{color.text.inverse}",
        "radius": "{radius.md}",
        "paddingX": "{space.4}",
        "paddingY": "{space.2}"
      }
    },
    "input": {
      "default": {
        "bg": "{color.bg.surface}",
        "text": "{color.text.default}",
        "border": "{color.border.default}",
        "radius": "{radius.sm}",
        "paddingX": "{space.4}",
        "paddingY": "{space.2}"
      }
    }
  }
}
