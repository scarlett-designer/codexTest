{
  "color": {
    "bg": {
      "primary": "#0F766E",
      "surface": "#F8FAFC"
    },
    "text": {
      "default": "#0B1220",
      "inverse": "#F8FAFC"
    },
    "border": {
      "default": "#94A3B8"
    }
  },
  "space": {
    "2": "0.625rem",
    "4": "1.125rem",
    "6": "1.75rem"
  },
  "radius": {
    "sm": "0.375rem",
    "md": "0.625rem"
  },
  "typography": {
    "fontFamily": "Pretendard, Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
    "fontSize": {
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.25rem"
    },
    "fontWeight": {
      "regular": 400,
      "semibold": 600
    }
  },
  "component": {
    "button": {
      "primary": {
        "bg": "{color.bg.primary}",
        "text": "{color.text.inverse}",
        "radius": "{radius.md}",
        "paddingX": "{space.4}",
        "paddingY": "{space.2}"
      }
    },
    "input": {
      "default": {
        "bg": "{color.bg.surface}",
        "text": "{color.text.default}",
        "border": "{color.border.default}",
        "radius": "{radius.sm}",
        "paddingX": "{space.4}",
        "paddingY": "{space.2}"
      }
    }
  }
}
